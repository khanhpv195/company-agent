# Base URL of the backend API (must also be allowed in tauri.conf.json -> app.security.csp connect-src)
VITE_API_URL=http://localhost:3000/api/v1

# 0 = talk to the real API at VITE_API_URL. 1 = serve everything from the in-app mock backend
# (src/mocks) for UI work without a backend.
VITE_MOCK=0

# Public legal pages linked from the register form (leave empty to show plain text without links)
VITE_TERMS_URL=
VITE_PRIVACY_URL=

# "Contact sales" address on the plan cards when online checkout is unavailable (empty hides it)
VITE_SALES_EMAIL=
