# App
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed CORS origins (Tauri macOS/Linux, Tauri Windows, Vite dev server)
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:1420
# Defaults to true outside production and false in production.
SWAGGER_ENABLED=true
# fatal | error | warn | info | debug | trace | silent. Logs are pretty in development, JSON otherwise.
LOG_LEVEL=info
# en | vi
FALLBACK_LANGUAGE=en

# Auth. JWT_ACCESS_SECRET must be at least 32 chars; generate one with `openssl rand -base64 48`.
# !!! DEV PLACEHOLDER ONLY: it is public in this repo. REPLACE it with a real random secret
# !!! for any shared, staging or production environment.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Durations: <number>[s|m|h|d] (30s, 15m, 12h, 30d)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Rate limit for /auth/* endpoints: max requests per window, per IP
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL=60s
# Global limits per minute: JWT routes are keyed by member id (public routes by IP), daemon
# gateway routes by computer id. /events, /health* and /billing/webhook are never limited.
API_THROTTLE_LIMIT=600
GATEWAY_THROTTLE_LIMIT=1200
# Argon2id cost (defaults are the library defaults; raise memory/time on strong hosts)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
# Password for `pnpm db:seed` users (defaults to password123 outside production;
# required when NODE_ENV=production)
SEED_PASSWORD=password123

# Agents: true runs the in-process simulator instead of real computer daemons (rejected in production)
AGENT_SIMULATOR=true
# Background loop: marks silent computers offline and expires leases
RECONCILE_ENABLED=true
# Interval (ms) of the `: ping` comment on the SSE stream (GET /api/v1/events)
SSE_HEARTBEAT_MS=25000
# Set to the number of reverse proxies in front of the API (e.g. 1) so rate limits see client IPs.
# Leave false when clients connect directly: otherwise X-Forwarded-For could be spoofed.
TRUST_PROXY=false

# Database (PostgreSQL 16). Use DB_HOST=postgres when the API runs inside docker compose.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=app
DB_LOGGING=false
# Never true in production (rejected by env validation). Prefer migrations everywhere.
DB_SYNCHRONIZE=false

# Public URL of the desktop/web app, used for the links in emails (reset, verify, invite)
APP_URL=http://localhost:1420
# log = write a redacted line and keep the last messages in memory (dev, tests only);
# smtp = send for real. NODE_ENV=production requires smtp, SMTP_HOST and MAIL_FROM.
MAIL_TRANSPORT=log
MAIL_FROM="Agent <no-reply@localhost>"
# Only read when MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# true = enforce plan limits (seats/agents/computers) and show the plan UI; false (default) = every
# workspace gets full functionality with no limits and no plan UI.
BILLING_LIMITS_ENABLED=false
# none = no online billing (checkout/portal answer 409); stripe = Stripe Checkout + webhooks.
# Plan limits follow BILLING_LIMITS_ENABLED. With stripe all four values below are required.
# Webhook URL to register in Stripe: <API origin>/api/v1/billing/webhook
# (events: checkout.session.completed, customer.subscription.created|updated|deleted)
BILLING_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# simulated = demo OAuth for Zalo/Facebook/Gmail (default outside production);
# disabled = authorize/connect answer 409 (the only value accepted in production).
CONNECTIONS_MODE=simulated

# Daily cleanup job (dead tokens, old invites, audit history, processed Stripe events)
RETENTION_ENABLED=true
AUDIT_RETENTION_DAYS=365
