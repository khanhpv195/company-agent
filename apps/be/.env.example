# App
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed CORS origins (Tauri macOS/Linux, Tauri Windows, Vite dev server)
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:1420
SWAGGER_ENABLED=true
# en | vi
FALLBACK_LANGUAGE=en

# Database (PostgreSQL 16). Use DB_HOST=postgres when the API runs inside docker compose.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=app
DB_LOGGING=false
# Never true in production (rejected by env validation). Prefer migrations everywhere.
DB_SYNCHRONIZE=false
