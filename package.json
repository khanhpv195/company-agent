{
  "name": "monorepo",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:be": "turbo run dev --filter=be",
    "dev:fe": "pnpm --filter @repo/shared build && pnpm --filter fe dev",
    "agent": "pnpm --filter @agent/cli start",
    "build": "turbo run build",
    "build:desktop": "pnpm --filter @repo/shared build && pnpm --filter fe tauri:build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test test:e2e",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f be",
    "db:migrate": "pnpm --filter be migration:run",
    "db:seed": "pnpm --filter be seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
