{
  "name": "@agent/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Daemon that connects a computer to the workspace and runs agents on Claude Code",
  "type": "module",
  "bin": {
    "agent": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
