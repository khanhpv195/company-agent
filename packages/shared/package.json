{
  "name": "@repo/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Types, interfaces and enums shared between apps/be and apps/fe",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "eslint": "^10.12.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3"
  }
}
