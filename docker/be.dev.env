# Dev-only defaults for the be container (docker-compose.yml). apps/be/.env overrides these.
# Public in the repo: never use this secret outside local development.
JWT_ACCESS_SECRET=dev-only-insecure-secret-change-me-0123456789
# Dev stack has no real daemons: keep the simulated computers online.
AGENT_SIMULATOR=true
# Run `scripts/seed.sh` after migrations on every container start (seeds are idempotent).
# Dev login: khanhpv@holatech.tech / password123 (SEED_PASSWORD).
RUN_SEED=true
# Dev keeps the demo behaviour: mails are logged (outbox), provider OAuth is simulated, no billing.
MAIL_TRANSPORT=log
CONNECTIONS_MODE=simulated
BILLING_LIMITS_ENABLED=false
BILLING_PROVIDER=none
LOG_LEVEL=debug
